# ── Supabase (client-side, safe to expose) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# ── Supabase (server-side, duplicated for SSR) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_PROJECT_ID=your-project-id

# ── Supabase (server-side only, KEEP SECRET) ──
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Encryption key for stored connection keys (server-side only)
APP_USER_CONNECTION_KEY_SECRET=base64-encoded-32-byte-key

# ── GitHub OAuth (server-side only) ──
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
